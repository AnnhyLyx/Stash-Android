# MihomoScript → Stash Android 专用版
# 目标：Stash Android 原生 .stoverride
# 原则：只使用 Stash Android 原生支持的 DNS / Proxy Group / Rule Provider / Rules。
# 不使用 Mihomo 专属的 sticky-sessions、path-in-bundle 等字段。
# 保留原版的地区分组、服务分流、MRS 规则集和国外 QUIC 拦截逻辑。
#
name: MihomoScript Stash 专用版
desc: Stash 原生 Override；地区自动测速、服务分流、DNS/Hosts、规则集和国外 QUIC 拦截。
author: OpenAI / based on user-provided mihomoScript.js
version: 2.0.3
dns: #!replace
  enable: true
  ipv6: true
  use-hosts: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/15
  fake-ip-range6: 2001:2::1/48
  fake-ip-filter:
  - localhost
  - '*.lan'
  - '*.local'
  - time.*.com
  - time.*.gov
  - time.*.edu.cn
  - time.*.apple.com
  - '*.ntp.org.cn'
  - '*.pool.ntp.org'
  default-nameserver:
  - 114.114.114.114
  - tls://223.5.5.5
  - https://1.12.12.12/dns-query
  proxy-server-nameserver:
  - 114.114.114.114
  - tls://223.5.5.5
  - https://doh.pub/dns-query
  nameserver:
  - https://cloudflare-dns.com/dns-query
  - https://dns.google/dns-query
  nameserver-policy:
    'geosite:private': system
    'geosite:cn':
    - 223.5.5.5
    - 119.29.29.29
  direct-nameserver:
  - 223.5.5.5
  - 119.29.29.29
  direct-nameserver-follow-policy: true

hosts: #!replace
  doh.pub:
  - 1.12.12.12
  - 120.53.53.53
  cloudflare-dns.com:
  - 1.1.1.1
  - 1.0.0.1
  dns.google:
  - 8.8.8.8
  - 8.8.4.4
  services.googleapis.cn: services.googleapis.com
  +.mcdn.bilivideo.com:
  - 0.0.0.0
  +.mcdn.bilivideo.cn:
  - 0.0.0.0
  +.edge.mountaintoys.cn:
  - 0.0.0.0
  +.h2.smtcdns.net:
  - 0.0.0.0

proxy-groups: #!replace
  - name: 手动选择
    type: select
    icon: https://fastly.jsdelivr.net/gh/AIsouler/MyClash@main/Icons/svg/Static.svg
    include-all: true
