    max-failed-times: 3
    icon: https://fastly.jsdelivr.net/gh/AIsouler/MyClash@main/Icons/svg/Airport.svg
    include-all: true
    filter: (?:[*×✕✖⨯⨉x](?:[2-9]\d*|[1-9]\d+)(?:\.\d+)?)|(?:(?<![\d.])(?:[2-9]\d*|[1-9]\d+)(?:\.\d+)?(?:倍|[*×✕✖⨯⨉x]))
