# MihomoScript → Stash 专用版
# 目标：Stash iOS / macOS / Android 原生 .stoverride
# 核心：使用 Stash 原生 include-all + filter 动态读取当前订阅节点。
# 不接管 mixed-port / TUN / external-controller / NTP 等系统级配置。
# 不修改原订阅的 proxies / proxy-providers；机场更新后节点自动进入策略组。
# 原 JS 中依赖运行时 JavaScript 的节点重命名/hosts 动态改写等逻辑，
# 本版只保留能由 Stash 原生配置稳定实现的部分。
#
name: MihomoScript Stash 专用版
desc: Stash 原生 Override；地区自动测速、服务分流、DNS/Hosts、规则集和国外 QUIC 拦截。
author: OpenAI / based on user-provided mihomoScript.js
version: 2.0.1

dns: #!replace
  enable: true
  ipv6: true
  use-hosts: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/15
  fake-ip-range6: 2001:2::1/48
  fake-ip-filter:
  - localhost
  - '*.lan'
  - '*.local'
  - time.*.com
  - time.*.gov
  - time.*.edu.cn
  - time.*.apple.com
  - '*.ntp.org.cn'
  - '*.pool.ntp.org'
  default-nameserver:
  - 114.114.114.114#DIRECT
  - tls://223.5.5.5#DIRECT
  - https://1.12.12.12/dns-query#DIRECT
  proxy-server-nameserver:
  - 114.114.114.114#DIRECT
  - tls://223.5.5.5#DIRECT
  - https://doh.pub/dns-query#DIRECT
  nameserver:
  - https://cloudflare-dns.com/dns-query#默认代理
  - https://dns.google/dns-query#默认代理
  nameserver-policy:
    rule-set:private: system
    rule-set:douyin:
    - system
    - 180.184.1.1
    - 180.184.2.2
    rule-set:cn:
    - 223.5.5.5#DIRECT
    - 119.29.29.29#DIRECT
  direct-nameserver:
  - 223.5.5.5#DIRECT
  - 119.29.29.29#DIRECT
  direct-nameserver-follow-policy: true

hosts: #!replace
  doh.pub:
  - 1.12.12.12
  - 120.53.53.53
  cloudflare-dns.com:
  - 1.1.1.1
  - 1.0.0.1
  dns.google:
  - 8.8.8.8
  - 8.8.4.4
  services.googleapis.cn: services.googleapis.com
  +.mcdn.bilivideo.com:
  - 0.0.0.0
  +.mcdn.bilivideo.cn:
  - 0.0.0.0
  +.edge.mountaintoys.cn:
  - 0.0.0.0
  +.h2.smtcdns.net:
  - 0.0.0.0

proxy-groups: #!replace
  - name: 手动选择
    type: select
    interval: 600
    timeout: 3000
    url: https://www.apple.com/library/test/success.html
    lazy: true
    max-failed-times: 3
    icon: https://fastly.jsdelivr.net/gh/AIsouler/MyClash@main/Icons/svg/Static.svg
    include-all: true
    filter: 群|返利|循环|官网|客服|网站|网址|获取|订阅|流量|到期|机场|下次|版本|官址|备用|过期|已用|联系|邮箱|工单|贩卖|通知|倒卖|防止|国内|地址|频道|电报|无法|说明|使用|提示|访问|支持|教程|关注|更新|作者|加入|超时|收藏|优惠|福利|邀请|好友|失联|选择|剩余|公益|发布|DIZTNA|通路|登录|禁止|定时|渠道|牢记|永久|余额|阁下|本站|刷新|导航|建议|重置|以下|过滤|⚠️|@|t\.me\/\+|\bexpire\b|\bhttps?:\/\/|\.com|\btraffic\b
  - name: 自动选择
    type: url-test
    interval: 600
    timeout: 3000
    url: https://www.apple.com/library/test/success.html
    lazy: true
    max-failed-times: 3
    icon: https://fastly.jsdelivr.net/gh/AIsouler/MyClash@main/Icons/svg/Auto.svg
    tolerance: 50
    include-all: true
    filter: 群|返利|循环|官网|客服|网站|网址|获取|订阅|流量|到期|机场|下次|版本|官址|备用|过期|已用|联系|邮箱|工单|贩卖|通知|倒卖|防止|国内|地址|频道|电报|无法|说明|使用|提示|访问|支持|教程|关注|更新|作者|加入|超时|收藏|优惠|福利|邀请|好友|失联|选择|剩余|公益|发布|DIZTNA|通路|登录|禁止|定时|渠道|牢记|永久|余额|阁下|本站|刷新|导航|建议|重置|以下|过滤|⚠️|@|t\.me\/\+|\bexpire\b|\bhttps?:\/\/|\.com|\btraffic\b
    hidden: true
  - name: 负载均衡
    type: load-balance
    interval: 600
    timeout: 3000
    url: https://www.apple.com/library/test/success.html
    lazy: true
    max-failed-times: 3
    icon: https://fastly.jsdelivr.net/gh/AIsouler/MyClash@main/Icons/svg/RoundRobin.svg
    strategy: sticky-sessions
    include-all: true
    filter: 群|返利|循环|官网|客服|网站|网址|获取|订阅|流量|到期|机场|下次|版本|官址|备用|过期|已用|联系|邮箱|工单|贩卖|通知|倒卖|防止|国内|地址|频道|电报|无法|说明|使用|提示|访问|支持|教程|关注|更新|作者|加入|超时|收藏|优惠|福利|邀请|好友|失联|选择|剩余|公益|发布|DIZTNA|通路|登录|禁止|定时|渠道|牢记|永久|余额|阁下|本站|刷新|导航|建议|重置|以下|过滤|⚠️|@|t\.me\/\+|\bexpire\b|\bhttps?:\/\/|\.com|\btraffic\b
    hidden: true
  - name: 香港-自动选择
    type: url-test
    interval: 600
    timeout: 3000
    url: https://www.apple.com/library/test/success.html
    lazy: true
    max-failed-times: 3
    icon: https://fastly.jsdelivr.net/gh/AIsouler/MyClash@main/Icons/svg/Auto.svg
    tolerance: 50
    include-all: true
    filter: 🇭🇰|香港|(?<![A-Za-z])HKG?(?![A-Za-z])|hong\s*kong
    hidden: true
  - name: 香港
    type: select
    interval: 600
    timeout: 3000
    url: https://www.apple.com/library/test/success.html
    lazy: true
    max-failed-times: 3
    icon: https://fastly.jsdelivr.net/gh/AIsouler/MyClash@main/Icons/svg/HongKong.svg
    include-all: true
    filter: 🇭🇰|香港|(?<![A-Za-z])HKG?(?![A-Za-z])|hong\s*kong
    hidden: false
  - name: 日本-自动选择
    type: url-test
    interval: 600
    timeout: 3000
    url: https://www.apple.com/library/test/success.html
    lazy: true
    max-failed-times: 3
    icon: https://fastly.jsdelivr.net/gh/AIsouler/MyClash@main/Icons/svg/Auto.svg
    tolerance: 50
    include-all: true
    filter: 🇯🇵|日本|东京|大阪|京都|(?<![A-Za-z])JPN?(?![A-Za-z])|japan
    hidden: true
  - name: 日本
    type: select
    interval: 600
    timeout: 3000
    url: https://www.apple.com/library/test/success.html
    lazy: true
    max-failed-times: 3
    icon: https://fastly.jsdelivr.net/gh/AIsouler/MyClash@main/Icons/svg/Japan.svg
    include-all: true
    filter: 🇯🇵|日本|东京|大阪|京都|(?<![A-Za-z])JPN?(?![A-Za-z])|japan
    hidden: false
