    lazy: true
    max-failed-times: 3
    icon: https://fastly.jsdelivr.net/gh/AIsouler/MyClash@main/Icons/svg/Taiwan.svg
    include-all: true
    filter: 🇹🇼|台湾|台北|高雄|(?<![A-Za-z])TWN?(?![A-Za-z])|taiwan
    hidden: false
  - name: 低倍率节点
    type: select
    interval: 600
    timeout: 3000
    url: https://www.apple.com/library/test/success.html
    lazy: true
    max-failed-times: 3
    icon: https://fastly.jsdelivr.net/gh/AIsouler/MyClash@main/Icons/svg/Available.svg
    include-all: true
    filter: ^(?!.*(?:剩|期)).*(?:(?<!\d)0(\.[0-5]|[*×✕✖⨯⨉x倍]))|(?:[*×✕✖⨯⨉x]0)|^(?!.*(?:客户端|软件)).*下载|低倍|免费|(?<![A-Za-z])free(?![A-Za-z])
